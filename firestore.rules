rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Enquiries: anyone can CREATE (public website form submissions)
    // Only authenticated admin can read, update, or delete
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Students: only authenticated admin can read/write
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }
    
    // Courses: only authenticated admin can read/write
    match /courses/{courseId} {
      allow read, write: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
